# Copy to .env for local `vercel dev` use — never commit the real .env file.

# Airtable Personal Access Token, scoped read-only to the "JL Setters" base
# (appYB6z0rRZ4QNbH5). Create at: https://airtable.com/create/tokens
# Scopes needed: data.records:read, schema.bases:read
AIRTABLE_TOKEN=

# Google Cloud Service Account JSON key, pasted as a single-line JSON string.
# Only used for the Calendly bookings sheet now — the setter/SDR/closer data
# has moved to Airtable.
# 1. Create a project (or reuse one), enable the "Google Sheets API".
# 2. Create a Service Account, add a JSON key, download it.
# 3. Share the Calendly response sheet with the service account's email
#    address (Viewer access is enough).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional — enables the Ad Spend / ROAS numbers on the Overview. Without it,
# that section shows "not connected" instead of breaking the rest of the
# dashboard. A Meta Marketing API token (System User token recommended —
# doesn't expire like a regular long-lived token does) with ads_read
# permission on all 3 ad accounts:
# JG (1487613569508490), LS (1676143043837220), JL Agency (1446377807296882).
# Create at: https://business.facebook.com/settings/system-users
META_ACCESS_TOKEN=
