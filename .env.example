# Copy to .env for local `vercel dev` use — never commit the real .env file.

# Google Cloud Service Account JSON key, pasted as a single-line JSON string.
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# 1. Create a project (or reuse one), enable the "Google Sheets API".
# 2. Create a Service Account, add a JSON key, download it.
# 3. Share all 4 sheets (Pink, Affiliates, Dialler, and the Blue "2026 B2C KPI
#    Tracker") with the service account's email address (Viewer access is enough).
# 4. Paste the entire downloaded JSON file's contents here as one line.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional — enables the Ad Spend / ROAS numbers. Without it, that section shows
# "not connected" instead of breaking the rest of the dashboard.
# A Meta Marketing API token (System User token recommended — doesn't expire like
# a regular long-lived token does) with ads_read permission on all 3 ad accounts:
# JG (1487613569508490), LS (1676143043837220), JL Agency (1446377807296882).
# Create at: https://business.facebook.com/settings/system-users
META_ACCESS_TOKEN=
